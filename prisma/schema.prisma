generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Book {
  id             Int     @id @default(autoincrement())
  title          String
  gender         String
  year           Int
  wasRead        Boolean
  isInTheLibrary Boolean
  bookCover      String?
}
